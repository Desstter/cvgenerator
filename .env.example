AI_PROVIDER=openai
# Una clave por proveedor: sustituye los valores vacios por tus claves reales.
# No compartas este archivo ni incluyas comillas tipograficas.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Modelos por defecto; la CLI permite elegir un modelo distinto en cada prueba.
# Produccion: Sol (mejor calidad medida); Luna es la alternativa barata.
OPENAI_MODEL=gpt-6.2-sol
OPENAI_SERVICE_TIER=fast
DEEPSEEK_MODEL=deepseek-flash
GEMINI_MODEL=gemini-2.5-flash

# In production, keep editable CVs, history and PDFs outside the Git checkout.
# CV_DATA_DIR=/srv/projects/cvgenerator-data
# UPLOADS_DIR=/srv/projects/cvgenerator-data/uploads
# OUTPUTS_DIR=/srv/projects/cvgenerator-data/outputs
# SAVED_DIR=/srv/projects/cvgenerator-data/saved
